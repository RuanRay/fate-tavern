# 伺服器執行設定範本（設定檔總表 §16）
# 用法：複製成 .env.local 再改值；.env.local 不進 repo（AGENTS §4-8）
# 本檔只放本機開發值，staging／production 的祕密放主機的祕密管理

APP_ENV=local
# 對應 infra/docker-compose.yml 的預設值；資料庫名稱要帶環境名（M0-R16）
DATABASE_URL=postgres://fate_tavern:fate_tavern_local_pw@127.0.0.1:5432/fate_tavern_local
PUBLIC_BASE_URL=https://localhost:5173
# 管理密碼的雜湊（M0-R12 建立後補上產生方式）
ADMIN_PASSWORD_HASH=replace-me
# 至少 32 bytes：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_SIGNING_KEY=replace-me-with-at-least-32-bytes
ALLOW_TEST_MODE=true
LOG_LEVEL=info
SENTRY_DSN=

HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
HOST_HEARTBEAT_TIMEOUT_MS=10000
JOIN_TOKEN_TTL_MS=600000
JOIN_RATE_LIMIT_PER_MIN=10
RESEND_BUFFER_SIZE=500
MAX_MESSAGE_BYTES=65536
SEAT_HOLD_MS=180000
HOST_SESSION_TTL_MS=259200000
WS_MSG_RATE_PER_SEC=30
SNAPSHOT_EVERY_EVENTS=30
